# Copy to backend/.env and fill in. NEVER commit .env and never put these values in the frontend.
# At least one AI provider is required. Configure as many as you like: the router uses them
# together and falls back to the next one if a provider is rate limited or down.

# ---------------------------------------------------------------- AI providers
# Each provider needs <NAME>_API_KEY and a model. Model names change over time: check your
# provider's documentation for the current ones.
#   <NAME>_MODEL            default model for everyday questions
#   <NAME>_FAST_MODEL       optional cheaper/faster model for short, easy questions
#   <NAME>_REASONING_MODEL  optional strongest model for proofs, derivations, research level
#   <NAME>_VISION_MODEL     optional model that is guaranteed to read images
#   <NAME>_VISION=true      set when ALL models of that provider accept images
#   <NAME>_TOOLS=false      set if the model does not support function calling
#   <NAME>_BASE_URL         override the endpoint (proxies, self-hosted servers)

# Anthropic (defaults are filled in for the three model slots; override if you like)
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5
#ANTHROPIC_FAST_MODEL=claude-haiku-5-5
#ANTHROPIC_REASONING_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
#OPENAI_MODEL=
#OPENAI_REASONING_MODEL=

# Google Gemini (uses Google's OpenAI-compatible endpoint; has a free tier with rate limits)
GEMINI_API_KEY=
#GEMINI_MODEL=
#GEMINI_REASONING_MODEL=

# Groq (free tier with rate limits; text models, so set a vision model separately if you want images)
GROQ_API_KEY=
#GROQ_MODEL=
#GROQ_VISION_MODEL=

# OpenRouter (one key, many models, some free)
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=

# Ollama: models running on your own computer (no key, no per-request cost)
#OLLAMA_MODEL=
#OLLAMA_VISION_MODEL=
#OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible server (vLLM, LM Studio, a company gateway, ...)
#CUSTOM_BASE_URL=
#CUSTOM_API_KEY=
#CUSTOM_MODEL=

# Order in which providers are preferred when several can serve a request
PROVIDER_PRIORITY=anthropic,openai,gemini,groq,openrouter,ollama,custom

# ---------------------------------------------------------------- security
# Comma-separated list of web origins allowed to call this API (your Hugging Face Space URL).
# Example: https://your-name-personal-super-ai.hf.space
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:7860
# Optional bearer token for your own scripts/apps. A static web page cannot keep a secret,
# so this does NOT protect browser traffic; CORS and the rate limit below do.
API_AUTH_TOKEN=
# Requests per minute per IP address. 0 = off (no artificial question limit). Turn on for a public deployment.
RATE_LIMIT_PER_MINUTE=0
# Let clients without X-Client-Id share one anonymous history (not recommended on a public server)
ALLOW_ANONYMOUS_HISTORY=false
# POST /api/compute exposes the SymPy/SciPy engines directly (useful for testing)
ENABLE_COMPUTE_API=false
ENVIRONMENT=development

# ---------------------------------------------------------------- storage
DATABASE_PATH=data/personal_super_ai.db

# ---------------------------------------------------------------- limits and timeouts
MAX_QUESTION_CHARS=20000
MAX_IMAGES=4
IMAGE_MAX_BYTES=12582912
IMAGE_MAX_SIDE=2048
REQUEST_TIMEOUT_SECONDS=240
PROVIDER_TIMEOUT_SECONDS=180
MAX_TOOL_ROUNDS=6
MAX_OUTPUT_TOKENS=4096
MAX_OUTPUT_TOKENS_REASONING=8192
# Leave empty to use each model's default temperature
TEMPERATURE=
# How many model calls run at once; extra requests wait up to QUEUE_TIMEOUT_SECONDS, then get a "busy" answer
MAX_CONCURRENT_REQUESTS=8
QUEUE_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- engines (SymPy / NumPy / SciPy)
# Calculations run in separate worker processes with a hard timeout and memory cap.
ENGINE_SANDBOX=true
ENGINE_WORKERS=2
ENGINE_TIMEOUT_SECONDS=20
ENGINE_MEMORY_MB=1536

# ---------------------------------------------------------------- features
# "offered" = this server can do it. "auto" = used without the client asking.
# web_research and long_term_memory need the client to switch them on.
OFFERED_FEATURES=math_verification,scientific_calc,web_research,long_term_memory
AUTO_FEATURES=math_verification,scientific_calc

# ---------------------------------------------------------------- research sources (no keys needed)
RESEARCH_SOURCES=wikipedia,arxiv,crossref
# Crossref asks API users to identify themselves with a contact address
CONTACT_EMAIL=
